{
  "name": "resolve",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first support agent that resolves, refunds, and closes the loop \u2014 live on the call.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "setup:voice": "tsx src/setup-voice.ts",
    "seed:repeat": "tsx src/seed-repeat.ts",
    "audit": "tsx src/audit-report.ts",
    "dev:web": "yarn --cwd web dev",
    "build:web": "yarn --cwd web build",
    "install:web": "yarn --cwd web install"
  },
  "dependencies": {
    "dodopayments": "^2.47.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
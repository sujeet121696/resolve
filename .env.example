# Resolve — environment template
# Copy to .env and fill in as keys arrive. .env is gitignored; this file is the checklist.

# --- Server (Step 1) ---
PORT=3000

# --- Brain switch ---
# mock   = free deterministic rules (local dev, no API key needed)
# auto   = groq primary + gemini fallback (the demo setting)
# groq   = Groq free tier (fast — measured p50 1.6 s propose+judge)
# gemini = Google AI Studio (free tier only 20 req/day — fallback only)
# claude = real Anthropic API (production path)
BRAIN=mock

# --- Provider seams (vendors are defaults, not dependencies) ---
# Same pattern as BRAIN: the agents talk to interfaces, so swapping a vendor is
# a new module plus a line in the factory — no agent/guard/escalation changes.
# Only one implementation of each ships today; these exist so adding the next
# one doesn't mean touching the runtime path.
PAYMENTS=dodo
HELPDESK=freshdesk
# local   = order facts from data/orders.json, written by the seed scripts.
# shopify = Shopify Admin GraphQL, read-only (see the Shopify block below).
# See oms.ts for what an order source must supply.
OMS=local

# --- Policy limits (the guard's hard checks) ---
# Auto-approve ceiling in MINOR UNITS, per currency. Denominated on purpose: one
# global number would mean ₹5,000 and $5,000 at once, so pointing OMS at a store
# in another currency would move the real ceiling without changing any config.
# Defaults if unset: INR 500000 (₹5,000), USD 5000 ($50).
# A currency with no ceiling configured fails CLOSED — the guard's
# unknown_currency hard check hands the case to a human rather than guessing.
AUTO_REFUND_LIMIT_INR=500000
AUTO_REFUND_LIMIT_USD=5000
# Store-wide return window in days; a product overrides it per order record
# with return_window_days. Default 14.
RETURN_WINDOW_DAYS=14

# --- Anthropic (Step 3 — the brain) ---
# console.anthropic.com → needs ~$5 credit. Only used when BRAIN=claude.
ANTHROPIC_API_KEY=

# --- Dodo Payments (Step 2 — refunds) ---
# Rotated test-mode key. NOTE: no "dodo_test_" prefix — copy verbatim.
# test_mode is mandatory; the SDK defaults to live and 401s (SPIKES.md).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# --- Freshdesk (Step 2 — tickets) ---
# Start the 21-day trial in early Sept so it's alive on Sept 25.
# Domain is the subdomain only, e.g. "resolve-demo" for resolve-demo.freshdesk.com
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# --- Shopify (optional order source — OMS=shopify) ---
# Working: integrations/shopify.ts is a real OrderSource, verified against a live
# dev store. Incomplete credentials make OMS=shopify fall back to local with a
# warning rather than take the flow down.
# Free dev store from dev.shopify.com (Stores -> Create store, type "Dev").
# Dev stores cannot process real transactions, so money stays on Dodo test mode —
# Shopify would only ever supply the ORDER (item, amount, fulfilment state).
# Scope needed: read_orders. Nothing writes back, by design.
# Domain is the full host, e.g. "your-store.myshopify.com"
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07
# Dev Dashboard app credentials, exchanged at runtime for a 24h access token
# (client_credentials grant). No long-lived token is stored anywhere.
# The grant only works when the app and the store are in the same Shopify org.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Email OTP (Step 5) ---
# Any SMTP: Gmail app password or Resend. Host/port below are Gmail defaults.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OTP_FROM_ADDRESS=

# --- ElevenLabs (Step 6 — voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Step 6 — voice tools (shared secret the ElevenLabs agent sends as x-resolve-token)
TOOLS_TOKEN=

# Seeded customers use @example.com addresses with no real inbox. Set this and
# ALL their mail — OTP codes and resolution confirmations — delivers here
# instead, so a demo can show the email arriving. Real addresses are unaffected.
OTP_DEMO_REDIRECT_TO=

# Public tunnel URL (ngrok static domain) — baked into ElevenLabs tool URLs
PUBLIC_BASE_URL=

# Gemini brain (BRAIN=gemini) — free key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq brain (BRAIN=groq) — free key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Escalation follow-up timer (Step 8) — minutes; set to 2 for demos
ESCALATION_FOLLOWUP_MINUTES=60

# --- Cost reporting (Step 9) ---
# USD per million tokens for the active brain, copied from the provider's
# pricing page. Set both and `npm run audit` prices the measured token counts;
# leave blank and it reports tokens only (never a made-up price).
LLM_PRICE_PER_MTOK_IN=
LLM_PRICE_PER_MTOK_OUT=
